pragma language_version >=0.1.0;

import CompactStandardLibrary;

// 1. Ledger State
export ledger isValidated: Boolean;

// 2. Witness (private/off-chain proof input)
witness assertEligible(): Boolean;

// 3. Circuit (Zero-Knowledge verification circuit)
export circuit verifyUser(): [] {
    const isEligible: Boolean = assertEligible();
    assert(isEligible, "User is not eligible for compliance verification");
    isValidated.write(true);
}